    "resblock_dilation_sizes": [[1,3,5], [1,3,5], [1,3,5]],
    "with_conformer":true,

    "segment_size": 57600,
    "num_mels": 128, 
    "n_fft": 512,
    "hop_size": 160,
    "win_size": 400,

    "sampling_rate": 16000,

    "fmin": 0,
    "fmax": 8000,
    "fmax_for_loss": null,

    "unit_name":"cluster_label",
    "valid_unit_name":"valid_cluster_label",
    "test_unit_name":"test_cluster_label",
    "unit_method":"HuBERT Label as input (ReVISE)",
    "k":2000,
    "unit_scale": 1.0,

    "save_on_metric": "acc_hu_class",
    "lower_the_better": false,

    "dist_config": {
        "dist_backend": "nccl",
        "dist_url": "tcp://localhost:55120",
        "world_size": 1
    }
