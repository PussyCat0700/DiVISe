{
    "resblock": "1",
    "num_gpus": 0,
    "batch_size": 10,
    "learning_rate": 6e-5,
    "adam_b1": 0.9,
    "adam_b2": 0.98,
    "total_updates":45000,
    "revise_setting":true,
    "frozen_steps":5000,
    "t1_percent":10,
    "t2_percent":20,
    "last_lr_factor":0.05,
    "seed": 1234,
    "base_alpha_avhubert": 60,

    "upsample_rates": [10,4,4,2],
